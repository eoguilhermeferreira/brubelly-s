# URL pública do site (usada em metadata, sitemap e nos back_urls do Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://www.brubellys.com.br

# --- Supabase --------------------------------------------------------------
# Sem estas variáveis, o site roda em MODO MOCK: catálogo, pedidos e clientes
# vêm de src/lib/mock-data.ts. Preencha para conectar ao banco real.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (Checkout Pro) --------------------------------------------
# Sem token, o checkout pula o pagamento real e vai direto para /checkout/sucesso
# (apenas para demonstração).
MERCADOPAGO_ACCESS_TOKEN=

# --- Melhor Envio ------------------------------------------------------------
# Sem token, o frete cai no valor fixo definido em src/config/store.ts.
MELHOR_ENVIO_TOKEN=

# --- Admin (modo mock) -------------------------------------------------------
# Login de demonstração do painel /admin enquanto o Supabase Auth não está
# conectado. Troque estes valores em produção.
ADMIN_DEMO_EMAIL=equipe@brubellys.com.br
ADMIN_DEMO_PASSWORD=brubellys2026
